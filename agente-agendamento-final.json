      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.2,
      "position": [
        3540,
        650
      ],
      "parameters": {
        "toolDescription": "Cria o evento no Google Calendar logo depois de criar_agendamento. Devolve o ID do evento.",
        "resource": "event",
        "operation": "create",
        "calendar": {
          "mode": "id",
          "value": "primary"
        },
        "start": "={{ $fromAI('inicio', 'Início do evento, ISO com fuso -03:00') }}",
        "end": "={{ $fromAI('fim', 'Fim do evento, ISO com fuso -03:00; use 1 hora após o início se não houver duração') }}",
        "additionalFields": {
          "summary": "={{ $fromAI('titulo', 'Título, ex: Consulta - Nome do cliente') }}"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "",
          "name": "Google Calendar"
        }
      }
    },
    {
      "id": "tool8",
      "name": "salvar_id_evento",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        3680,
        650
      ],
      "parameters": {
        "toolDescription": "Salva no agendamento o ID do evento criado no Google Calendar, para poder cancelar depois.",
        "operation": "executeQuery",
        "query": "UPDATE agendamentos SET google_event_id = $2 WHERE id = $1 RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $fromAI('agendamento_id', 'ID do agendamento'), $fromAI('google_event_id', 'ID do evento no Google Calendar') ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres VPS"
        }
      }
    },
    {
      "id": "tool9",
      "name": "deletar_evento_google",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.2,
      "position": [
        3820,
        650
      ],
      "parameters": {
        "toolDescription": "Apaga o evento do Google Calendar depois de cancelar o agendamento no banco. Se o agendamento não tiver google_event_id, não use esta ferramenta.",
        "resource": "event",
        "operation": "delete",
        "calendar": {
          "mode": "id",
          "value": "primary"
        },
        "eventId": "={{ $fromAI('google_event_id', 'ID do evento no Google Calendar') }}"
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "",
          "name": "Google Calendar"
        }
      }
    }
  ],
