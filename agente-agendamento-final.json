        }
      }
    },
    {
      "id": "tool1",
      "name": "listar_profissionais",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        2700,
        650
      ],
      "parameters": {
        "toolDescription": "Lista os profissionais ativos (nome e especialidade). Use para saber quem existe e como o nome está escrito.",
        "operation": "executeQuery",
        "query": "SELECT nome, especialidade FROM profissionais WHERE ativo = true;"
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres VPS"
        }
      }
    },
    {
      "id": "tool2",
      "name": "consultar_agendamentos",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        2840,
        650
      ],
      "parameters": {
        "toolDescription": "Consulta os agendamentos futuros do cliente atual (não cancelados).",
        "operation": "executeQuery",
        "query": "SELECT a.id, a.data_hora, a.status, a.google_event_id, p.nome AS profissional, p.google_calendar_id FROM agendamentos a JOIN profissionais p ON p.id = a.profissional_id JOIN clientes c ON c.id = a.cliente_id WHERE c.telefone = $1 AND a.data_hora >= now() AND a.status != 'cancelado' ORDER BY a.data_hora;",
        "options": {
          "queryReplacement": "={{ $('Code - Prepara Dados').item.json.chatId }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres VPS"
        }
      }
    },
    {
      "id": "tool3",
      "name": "verificar_disponibilidade",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        2980,
        650
      ],
      "parameters": {
        "toolDescription": "Verifica se o profissional já tem agendamento naquele horário. Retorna ocupado = true (horário ocupado) ou ocupado = false (livre).",
        "operation": "executeQuery",
        "query": "SELECT EXISTS (SELECT 1 FROM agendamentos a JOIN profissionais p ON p.id = a.profissional_id WHERE p.nome ILIKE '%' || $1 || '%' AND a.data_hora = $2::timestamptz AND a.status <> 'cancelado') AS ocupado;",
        "options": {
          "queryReplacement": "={{ [ $fromAI('profissional_nome', 'Nome do profissional, ex: Carlos'), $fromAI('data_hora', 'Data e hora, ISO com fuso -03:00, ex: 2026-10-17T10:00:00-03:00') ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres VPS"
        }
      }
    },
    {
      "id": "tool4",
      "name": "criar_agendamento",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        3120,
        650
      ],
      "parameters": {
        "toolDescription": "Cria o agendamento no banco. Só use depois de verificar_disponibilidade retornar ocupado = false. O cliente precisa estar cadastrado. Retorna o id do agendamento; se não retornar linha, o cliente não está cadastrado ou o nome do profissional não foi encontrado.",
        "operation": "executeQuery",
        "query": "INSERT INTO agendamentos (cliente_id, profissional_id, data_hora, status) SELECT cl.id, p.id, $3::timestamptz, 'agendado' FROM clientes cl, profissionais p WHERE cl.telefone = $1 AND p.nome ILIKE '%' || $2 || '%' AND p.ativo = true LIMIT 1 RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('Code - Prepara Dados').item.json.chatId, $fromAI('profissional_nome', 'Nome do profissional, ex: Carlos'), $fromAI('data_hora', 'Data e hora, ISO com fuso -03:00') ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres VPS"
        }
      }
    },
    {
      "id": "tool5",
      "name": "cancelar_agendamento",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        3260,
        650
      ],
      "parameters": {
        "toolDescription": "Cancela um agendamento pelo ID (obtido via consulta prévia). Devolve google_event_id e google_calendar_id: use-os logo depois na ferramenta de deletar evento do Google Calendar.",
        "operation": "executeQuery",
        "query": "UPDATE agendamentos a SET status = 'cancelado' FROM profissionais p WHERE a.id = $1 AND p.id = a.profissional_id RETURNING a.id, a.google_event_id, p.google_calendar_id;",
        "options": {
          "queryReplacement": "={{ $fromAI('agendamento_id', 'ID do agendamento a cancelar') }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres VPS"
        }
      }
    },
    {
      "id": "tool6",
      "name": "cadastrar_cliente",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        3400,
        650
      ],
      "parameters": {
        "toolDescription": "Cadastra ou atualiza o nome do cliente atual, se ele se apresentar.",
        "operation": "executeQuery",
        "query": "INSERT INTO clientes (telefone, nome) VALUES ($1, $2) ON CONFLICT (telefone) DO UPDATE SET nome = EXCLUDED.nome RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('Code - Prepara Dados').item.json.chatId, $fromAI('nome', 'Nome do cliente') ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres VPS"
        }
      }
    },
    {
