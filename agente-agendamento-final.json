    {
      "id": "code1",
      "name": "Code - Prepara Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst chatId = body?.data?.key?.remoteJid || body?.key?.remoteJid || 'desconhecido';\nconst texto = body?.data?.message?.conversation || body?.message?.conversation || '';\nconst pushName = body?.data?.pushName || body?.pushName || null;\nreturn [{ json: { chatId, texto, pushName, timestamp: Date.now() } }];"
      }
    },
    {
      "id": "redis1",
      "name": "Redis - Busca Buffer Atual",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        660,
        300
      ],
      "parameters": {
        "operation": "get",
        "key": "={{ 'buffer:' + $json.chatId }}",
        "options": {}
      },
      "credentials": {
        "redis": {
          "id": "",
          "name": "Redis VPS"
        }
      }
    },
    {
      "id": "code2",
      "name": "Code - Acrescenta Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "const bufferAtual = $json.propertyName || '';\nconst novaMsg = $('Code - Prepara Dados').item.json.texto;\nconst bufferNovo = bufferAtual ? (bufferAtual + '\\n' + novaMsg) : novaMsg;\nreturn [{ json: {\n  chatId: $('Code - Prepara Dados').item.json.chatId,\n  buffer: bufferNovo,\n  timestamp: $('Code - Prepara Dados').item.json.timestamp\n} }];"
      }
    },
